# Configuraciones operativas: versionar solo ejemplos revisados.
# Eureka no contiene credenciales ni conexiones a bases de datos.
application*.properties
application*.yml
application*.yaml
!eureka-server/src/main/resources/application.properties
bootstrap*.properties
bootstrap*.yml
bootstrap*.yaml
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Variables de entorno, claves y archivos de credenciales
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.secret
*.secrets
secrets.*
credentials.*
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
**/secrets/**
**/credentials/**

# Permitir ejemplos seguros, incluso en subdirectorios de secretos.
# Un sufijo .example no garantiza por si solo que el contenido sea seguro.
!**/secrets/**/
!**/credentials/**/
!*.example
