# Ejemplo inactivo. Requiere exactamente el mismo JWT_SECRET que Auth.
# Clave aleatoria segura: al menos 32 bytes UTF-8, sin limite maximo.
# Se usan los bytes UTF-8 del texto, sin decodificar Base64. Solo se acepta HS256.
server:
  port: 9090
  address: 127.0.0.1

spring:
  application:
    name: api-gateway
  main:
    web-application-type: reactive
  security:
    oauth2:
      resourceserver:
        jwt:
          secret-key: ${JWT_SECRET}
  cloud:
    gateway:
      discovery:
        locator:
          enabled: false
      routes:
        - id: auth-admin-usuarios
          uri: lb://identidad-service
          predicates:
            - Path=/api/v1/admin/usuarios
            - Method=GET,POST
        - id: auth-perfil
          uri: lb://identidad-service
          predicates:
            - Path=/api/v1/usuarios/me
            - Method=GET,PATCH
        # /api/pedidos y /api/admin/pedidos se dirigen a Ventas mediante PedidoRoutesConfig.
        - id: identidad-service
          uri: lb://identidad-service
          predicates:
            - Path=/auth/**
        - id: venta-service
          uri: lb://venta-service
          predicates:
            - Path=/api/ventas/**
        - id: catalogo-service
          uri: lb://catalogo-service
          predicates:
            - Path=/api/productos/**

eureka:
  instance:
    prefer-ip-address: true
    ip-address: 127.0.0.1
    instance-id: ${spring.application.name}:${server.port}
  client:
    fetch-registry: true
    register-with-eureka: true
    service-url:
      defaultZone: ${EUREKA_URL:http://127.0.0.1:8761/eureka/}

springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true
    path: /doc/swagger-ui.html
    urls:
      - name: 1. Catálogo Service
        url: /api/productos/v3/api-docs
      - name: 2. Venta Service
        url: /api/ventas/v3/api-docs
      - name: 8. Auth Service
        url: /auth/v3/api-docs
