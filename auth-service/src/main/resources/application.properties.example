spring.application.name=auth-service
server.port=9096

# Ejemplo inactivo. Definir valores propios antes de habilitar esta configuracion.
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.datasource.hikari.maximum-pool-size=5
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.max-lifetime=60000
spring.datasource.hikari.connection-timeout=10000
spring.datasource.hikari.validation-timeout=5000
spring.datasource.hikari.keepalive-time=30000

spring.jpa.show-sql=true
spring.jpa.hibernate.ddl-auto=update

# Sin clave incorporada ni valor predeterminado.
# Compartir con Gateway. Usar una clave aleatoria segura de 32 a 47 bytes
# (preferiblemente 32 bytes ASCII) para que el emisor actual seleccione HS256.
# Claves mayores seleccionan HS384/HS512 y se rechazan al configurar el decoder.
jwt.secret=${JWT_SECRET}

eureka.client.fetch-registry=true
eureka.client.register-with-eureka=true
eureka.client.serviceUrl.defaultZone=http://eureka-server:8761/eureka/
eureka.instance.prefer-ip-address=true
eureka.instance.instance-id=${spring.application.name}:${server.port}

springdoc.override-with-generic-response=false
springdoc.api-docs.path=/auth/v3/api-docs
server.forward-headers-strategy=framework
