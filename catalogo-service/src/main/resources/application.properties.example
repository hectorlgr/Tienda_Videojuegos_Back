spring.application.name=catalogo-service
server.port=9091

# Base nueva, creada manualmente. No se crean bases de forma automática.
spring.datasource.url=jdbc:mysql://127.0.0.1:3306/checkpoint_store_catalogo?serverTimezone=UTC
spring.datasource.username=${CATALOGO_DB_USERNAME}
spring.datasource.password=${CATALOGO_DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
# El esquema se crea manualmente desde Workbench.
spring.sql.init.mode=never

eureka.client.fetch-registry=true
eureka.client.register-with-eureka=true
eureka.client.serviceUrl.defaultZone=${EUREKA_URL:http://127.0.0.1:8761/eureka/}
eureka.instance.prefer-ip-address=true
eureka.instance.ip-address=127.0.0.1
eureka.instance.instance-id=${spring.application.name}:${server.port}

springdoc.override-with-generic-response=false
springdoc.api-docs.path=/api/productos/v3/api-docs
server.forward-headers-strategy=framework
